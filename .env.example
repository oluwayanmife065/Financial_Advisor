# ── LLM Backend ──
# Set to "groq" for hosted/production, "ollama" for local development
LLM_BACKEND=groq

# ── Groq (cloud LLM — default for hosted) ──
GROQ_API_KEY=gsk_your-groq-api-key-here
GROQ_MODEL=llama-3.1-8b-instant

# ── Ollama (local LLM — optional, local dev only) ──
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_BASE_URL=http://localhost:11434

# ── Pinecone (cloud vector store) ──
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_INDEX_NAME=fin-rag
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ── LLM Judge (eval scoring) ──
# OPENAI_API_KEY=sk-proj-your-key-here
# EVAL_JUDGE_MODEL=gpt-4o-mini
